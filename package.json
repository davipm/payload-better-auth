{
  "name": "@davipm/payload-better-auth",
  "version": "0.1.13",
  "description": "Better Auth adapter and plugins for Payload CMS",
  "license": "MIT",
  "type": "module",
  "author": "Davi Mendonca @davipm",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "import": "./dist/exports/client.js",
      "types": "./dist/exports/client.d.ts",
      "default": "./dist/exports/client.js"
    },
    "./rsc": {
      "import": "./dist/exports/rsc.js",
      "types": "./dist/exports/rsc.d.ts",
      "default": "./dist/exports/rsc.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun clean && bun copyfiles && bun build:types && bun build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --outDir dist --rootDir ./src",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "dev": "next dev dev --turbo",
    "dev:generate-importmap": "bun dev:payload generate:importmap",
    "dev:generate-types": "bun dev:payload generate:types && tsx src/scripts/generate-types.ts",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "generate:importmap": "bun dev:generate-importmap",
    "generate:types": "bun dev:generate-types",
    "db:create": "bun run dev:payload migrate:create",
    "db:migrate": "bun run dev:payload migrate",
    "db:status": "bun run dev:payload migrate:status",
    "db:down": "bun run dev:payload migrate:down",
    "db:refresh": "bun run dev:payload migrate:refresh",
    "db:reset": "bun run dev:payload migrate:reset",
    "db:fresh": "bun run dev:payload migrate:fresh",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "bun test:int && bun test:e2e",
    "test:e2e": "playwright test",
    "test:int": "vitest"
  },
  "devDependencies": {
    "@better-auth/api-key": "^1.7.25",
    "@better-auth/oauth-provider": "^1.7.25",
    "@better-auth/passkey": "^1.7.25",
    "@better-auth/sso": "^1.7.25",
    "@better-auth/stripe": "^1.7.25",
    "@biomejs/biome": "2.6.8",
    "@hookform/resolvers": "^7.0.7",
    "@payloadcms/db-mongodb": "3.93.0",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/db-sqlite": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@playwright/test": "1.65.1",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "better-auth-harmony": "^1.3.2",
    "copyfiles": "2.4.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "graphql": "^17.1.0",
    "mongodb-memory-server": "11.3.0",
    "next": "16.4.6",
    "open": "^11.0.4",
    "payload": "3.93.0",
    "qs-esm": "8.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "rimraf": "6.1.4",
    "sharp": "^0.35.5",
    "sort-package-json": "^4.1.0",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@hookform/resolvers": ">=7.0.7 <8",
    "@payloadcms/ui": ">=3.90.0 <4",
    "@payloadcms/next": ">=3.90.0 <4",
    "@better-auth/api-key": ">=1.7.25 <2",
    "@better-auth/passkey": ">=1.7.25 <2",
    "better-auth": ">=1.7.25 <2",
    "payload": ">=3.90.0 <4",
    "next": ">=16.4.5 <17",
    "react": ">=19.2.1 <20",
    "react-hook-form": ">=7.92.0 <8"
  },
  "peerDependenciesMeta": {
    "@better-auth/api-key": {
      "optional": true
    }
  },
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin",
    "better-auth",
    "authentication",
    "payload-auth",
    "nextjs",
    "adapter"
  ],
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "esbuild",
    "unrs-resolver"
  ],
  "registry": "https://registry.npmjs.org/",
  "dependencies": {
    "qrcode.react": "^4.2.0"
  }
}
