{
  "name": "@davipm/payload-better-auth",
  "version": "0.1.2",
  "description": "Better Auth adapter and plugins for Payload CMS",
  "license": "MIT",
  "type": "module",
  "author": "Davi Mendonca @davipm",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "import": "./dist/exports/client.js",
      "types": "./dist/exports/client.d.ts",
      "default": "./dist/exports/client.js"
    },
    "./rsc": {
      "import": "./dist/exports/rsc.js",
      "types": "./dist/exports/rsc.d.ts",
      "default": "./dist/exports/rsc.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun copyfiles && bun build:types && bun build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --outDir dist --rootDir ./src",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "dev": "next dev dev --turbo",
    "dev:generate-importmap": "bun dev:payload generate:importmap",
    "dev:generate-types": "bun dev:payload generate:types && tsx src/scripts/generate-types.ts",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "generate:importmap": "bun dev:generate-importmap",
    "generate:types": "bun dev:generate-types",
    "db:create": "bun run dev:payload migrate:create",
    "db:migrate": "bun run dev:payload migrate",
    "db:status": "bun run dev:payload migrate:status",
    "db:down": "bun run dev:payload migrate:down",
    "db:refresh": "bun run dev:payload migrate:refresh",
    "db:reset": "bun run dev:payload migrate:reset",
    "db:fresh": "bun run dev:payload migrate:fresh",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "bun test:int && bun test:e2e",
    "test:e2e": "playwright test",
    "test:int": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@payloadcms/db-mongodb": "3.92.1",
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/db-sqlite": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@playwright/test": "1.63.0",
    "@swc-node/register": "1.10.9",
    "@swc/cli": "0.6.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "copyfiles": "2.4.1",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "mongodb-memory-server": "10.1.4",
    "next": "16.4.5",
    "open": "^11.0.4",
    "payload": "3.92.1",
    "qs-esm": "8.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rimraf": "3.0.2",
    "sharp": "^0.35.5",
    "sort-package-json": "^2.10.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "payload": "^3.92.1"
  },
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin",
    "better-auth",
    "authentication",
    "adapter"
  ],
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "esbuild",
    "unrs-resolver"
  ],
  "registry": "https://registry.npmjs.org/",
  "dependencies": {
    "@better-auth/api-key": "^1.7.18",
    "@better-auth/oauth-provider": "^1.7.18",
    "@better-auth/passkey": "^1.7.18",
    "@better-auth/sso": "^1.7.18",
    "@better-auth/stripe": "^1.7.18",
    "@tanstack/react-form": "^1.33.5",
    "better-auth": "^1.7.18",
    "better-auth-harmony": "^1.3.2",
    "lucide-react": "^1.70.0",
    "qrcode.react": "^4.2.0",
    "react-hook-form": "^7.91.0",
    "zod": "^4.6.7"
  }
}
