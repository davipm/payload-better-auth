# SERVER
DATABASE_URL=file:./fizz.db
DATABASE_AUTH_TOKEN=SECRET_HERE
PAYLOAD_SECRET=SECRET_HERE
PREVIEW_SECRET=YOUR_SECRET_HERE
CRON_SECRET=YOUR_CRON_SECRET_HERE
BETTER_AUTH_SECRET=SECRET_HERE

# R2
R2_BUCKET=fizz
R2_REGION=auto
R2_ACCESS_KEY_ID=SECRET_HERE
R2_SECRET_ACCESS_KEY=SECRET_HERE
R2_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.yourdomain.com

# GOOGLE
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_SECRET=

# RESEND
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev
CONTACT_EMAIL=you@example.com

# PUBLIC
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
