{
  "extends": "../tsconfig.json",
  "exclude": ["int.spec.ts"],
  "include": [
    "**/*.js",
    "**/*.jsx",
    "**/*.mjs",
    "**/*.cjs",
    "**/*.ts",
    "**/*.tsx",
    "next.config.mjs",
    ".next/types/**/*.ts"
  ],
  "compilerOptions": {
    "rootDir": "..",
    "paths": {
      "@payload-config": ["./payload.config.ts"]
    },
    "noEmit": true,
    "emitDeclarationOnly": false
  }
}
